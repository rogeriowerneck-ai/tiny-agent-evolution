# Ollama endpoint reachable from the Tiny Agent container.
#
# Examples:
#
# Ollama on another machine over the local network:
# OLLAMA_URL=http://192.168.1.100:11434/api/chat
#
# Ollama on another Tailscale node using MagicDNS:
# OLLAMA_URL=http://my-ollama-host:11434/api/chat
#
# Ollama model:
OLLAMA_URL=http://YOUR_OLLAMA_HOST:11434/api/chat
OLLAMA_MODEL=qwen3:8b
